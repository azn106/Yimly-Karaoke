# ==========================================
# YIMLY ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize values
# ==========================================

# Port where Yimly server will be exposed on the host (Default: 3010)
PORT=3010

# Secret key used for signing JWT authentication tokens (REQUIRED in production)
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Host directory for persistent SQLite database and application data
# Defaults to the ./data folder in the project directory
DATA_PATH=./data

# Host directory for your karaoke media collection (MP3 + LRC files)
# Defaults to the ./media folder in the project directory
# Mounted inside the container as /media (read-only)
MEDIA_PATH=./media

# Media library watcher polling interval in milliseconds (Default: 3000)
# Ensures change detection on Docker bind mounts (e.g. Windows/macOS host volumes)
WATCH_POLL_INTERVAL_MS=3000

# Optional: Google Gemini API key if AI features are enabled
GEMINI_API_KEY=
